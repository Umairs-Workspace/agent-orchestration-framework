{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://aof.local/schemas/work-board.schema.json",
  "title": "AOF work board definition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "board",
    "adapter",
    "mappings",
    "operations"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "board": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "adapter": {
      "type": "string",
      "minLength": 1
    },
    "mappings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "types",
        "fields",
        "states",
        "relations",
        "order"
      ],
      "properties": {
        "types": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "fields": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "ref",
            "title",
            "correlation",
            "membership"
          ],
          "properties": {
            "ref": {
              "type": "string",
              "minLength": 1
            },
            "title": {
              "type": "string",
              "minLength": 1
            },
            "correlation": {
              "type": "string",
              "minLength": 1
            },
            "membership": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "states": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "relations": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "parent",
            "depends"
          ],
          "properties": {
            "parent": {
              "type": "string",
              "minLength": 1
            },
            "depends": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "order": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "operations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "readItems",
        "readChanges",
        "applyChanges"
      ],
      "properties": {
        "readItems": {
          "type": "string",
          "minLength": 1
        },
        "readChanges": {
          "type": "string",
          "minLength": 1
        },
        "applyChanges": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "accessProbe": {
          "type": "string",
          "minLength": 1
        },
        "attachments": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "paths",
            "copy"
          ],
          "properties": {
            "paths": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "copy": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
