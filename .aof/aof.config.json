{
  "$schema": "https://aof.local/schemas/aof.schema.json",
  "name": "aof",
  "work": {
    "dir": "./wiki/work",
    "intake": "backlog",
    "agents": {
      "productOwner": "inline",
      "session": {
        "effort": {
          "refine": "high",
          "continue": "high",
          "verify": "high"
        }
      }
    },
    "codeReview": {
      "autoComplete": false
    },
    "rubric": {
      "command": [
        "node",
        "scripts/test-rubric.mjs"
      ],
      "report": {
        "format": "tap",
        "floor": 500
      }
    },
    "plan": {
      "enabled": true
    },
    "examples": {
      "enabled": true
    },
    "diagrams": {
      "generator": "diagram-design",
      "formats": [
        "svg",
        "png"
      ],
      "style": ".aof/diagrams/style.md"
    },
    "test": {
      "command": "node",
      "args": [
        "scripts/test.mjs"
      ],
      "selectArgs": [
        "--only",
        "{file}"
      ],
      "roots": [
        "test"
      ],
      "deadlineMs": 7200000,
      "report": {
        "format": "tap"
      }
    },
    "worktree": {
      "prepare": {
        "command": "node",
        "args": [
          "scripts/prepare-worktree.mjs"
        ],
        "deadlineMs": 900000
      }
    },
    "autonomous": {
      "maxAttempts": 3
    },
    "tags": {
      "layers": [
        "@cli",
        "@ui",
        "@docs"
      ],
      "refinements": [
        "@work",
        "@planning",
        "@assets",
        "@adapter"
      ],
      "domains": [
        "@work-stream",
        "@validate",
        "@scaffold",
        "@planning",
        "@board",
        "@distribution",
        "@round-trip",
        "@memory",
        "@design"
      ]
    },
    "observability": {
      "cacheRatioTarget": 13
    },
    "doctor": {
      "budgets": {
        "architecture": 1400
      }
    },
    "loop": {
      "concurrency": "refine_first",
      "startToCloseMs": 14400000,
      "scheduleToCloseMs": 43200000
    },
    "notify": {
      "channels": {
        "discord": {
          "type": "discord",
          "channelId": "1553365880904089651",
          "allow": [
            "1119197349521137757"
          ]
        }
      }
    }
  },
  "memory": {
    "backend": "graphify"
  },
  "resources": [],
  "packages": [],
  "runtimes": [
    "claude",
    "codex",
    "opencode"
  ],
  "mesh": {
    "workspaceId": "9db1fd84f5895e38",
    "repo": {
      "cloneUrl": "https://github.com/Umairs-Workspace/agent-orchestration-framework.git",
      "published": true,
      "publishedAt": "2026-08-31T17:47:25.361Z",
      "workspaceId": "9db1fd84f5895e38"
    }
  },
  "settings": {
    "claude": {
      "effortLevel": "high"
    }
  }
}
