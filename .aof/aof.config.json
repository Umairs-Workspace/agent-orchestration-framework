{
  "$schema": "https://aof.local/schemas/aof.schema.json",
  "name": "aof",
  "work": {
    "dir": "./wiki/work",
    "intake": "backlog",
    "agents": {
      "productOwner": "inline",
      "mode": "solo",
      "session": {
        "effort": {
          "refine": "high",
          "continue": "high",
          "verify": "high"
        }
      }
    },
    "integrations": {
      "hyperagent": {}
    },
    "rubric": {
      "command": [
        "node",
        "scripts/test-rubric.mjs"
      ],
      "report": {
        "format": "tap",
        "floor": 500
      }
    },
    "plan": {
      "enabled": true
    },
    "examples": {
      "enabled": true
    },
    "diagrams": {
      "generator": "diagram-design",
      "formats": [
        "svg",
        "png"
      ],
      "style": ".aof/diagrams/style.md"
    },
    "test": {
      "command": "node",
      "args": [
        "scripts/test.mjs"
      ],
      "selectArgs": [
        "{file}"
      ],
      "selectProgramArgs": [
        "scripts/test-shard.mjs"
      ],
      "roots": [
        "test",
        "apps/ui/test",
        "packages/core/test",
        "packages/diagrams-ui/test",
        "packages/diagrams/test",
        "packages/execution/test",
        "packages/foundation/test",
        "packages/integration-hyperagent/test",
        "packages/integration-notion/test",
        "packages/knowledge/test",
        "packages/learning/test",
        "packages/mesh/test",
        "packages/specification-by-example/test",
        "packages/work-graph/test",
        "packages/work-loop/test",
        "packages/work/test"
      ],
      "suiteSuffixes": [
        ".test.mjs",
        ".suite.mjs"
      ],
      "exclude": [
        {
          "paths": [
            "packages/*/test/**/*.test.mjs",
            "apps/*/test/**/*.test.mjs"
          ],
          "why": "a workspace's native node:test files: its `test` script runs them through scripts/test-workspace.mjs (`node --test`), scripts/test.mjs registers only its *.suite.mjs array suites, and the per-file runner scripts/test-shard.mjs rejects a native file (\"exports no array\")"
        }
      ],
      "deadlineMs": 7200000,
      "report": {
        "format": "tap"
      },
      "gate": {
        "args": [
          "scripts/test-sharded.mjs",
          "--unit-timeout-min",
          "45"
        ],
        "jobsArgs": [
          "--jobs",
          "{jobs}"
        ],
        "budgetArgs": [
          "--budget-min",
          "{minutes}"
        ],
        "reportArgs": [
          "--report-json",
          "{report}"
        ],
        "filesArgs": [
          "--files",
          "{files}"
        ],
        "noLanesArgs": [
          "--no-lanes"
        ]
      }
    },
    "worktree": {
      "prepare": {
        "command": "node",
        "args": [
          "scripts/prepare-worktree.mjs"
        ],
        "deadlineMs": 900000
      }
    },
    "autonomous": {
      "maxAttempts": 3
    },
    "tags": {
      "layers": [
        "@cli",
        "@ui",
        "@docs"
      ],
      "refinements": [
        "@work",
        "@planning",
        "@assets",
        "@adapter"
      ],
      "domains": [
        "@work-stream",
        "@validate",
        "@scaffold",
        "@planning",
        "@board",
        "@distribution",
        "@round-trip",
        "@memory",
        "@design"
      ]
    },
    "observability": {
      "cacheRatioTarget": 13
    },
    "doctor": {
      "budgets": {
        "architecture": 1400
      }
    },
    "loop": {
      "concurrency": "refine_first",
      "refine": "whole-item",
      "startToCloseMs": 14400000,
      "heartbeatMs": 1800000,
      "scheduleToCloseMs": 43200000
    },
    "notify": {
      "channels": {
        "discord": {
          "type": "discord",
          "channelId": "1553365880904089651",
          "allow": [
            "1119197349521137757"
          ]
        }
      }
    }
  },
  "memory": {
    "backend": "graphify",
    "graph": {
      "share": "git-refs"
    }
  },
  "resources": [],
  "packages": [],
  "runtimes": [
    "claude",
    "codex",
    "opencode"
  ],
  "mesh": {
    "workspaceId": "9db1fd84f5895e38",
    "repo": {
      "cloneUrl": "https://github.com/Umairs-Workspace/agent-orchestration-framework.git",
      "published": true,
      "publishedAt": "2026-08-31T17:47:25.361Z",
      "workspaceId": "9db1fd84f5895e38"
    }
  },
  "settings": {
    "claude": {
      "effortLevel": "high"
    }
  }
}
