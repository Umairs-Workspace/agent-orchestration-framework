{
  "permissions": {
    "allow": [
      "Bash(npm test)"
    ],
    "deny": [
      "Edit(.aof/loops/**)",
      "Write(.aof/loops/**)",
      "Edit(.aof/acceptor-criterion.jsonc)",
      "Write(.aof/acceptor-criterion.jsonc)",
      "Edit(.aof/acceptor-ledger.jsonl)",
      "Write(.aof/acceptor-ledger.jsonl)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "say done"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "npm run lint",
            "aofManaged": "lint-on-stop"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "aof session start",
            "aofManaged": "claude-session-start"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "aof session ping",
            "aofManaged": "claude-session-prompt-ping"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "aof session end",
            "aofManaged": "claude-session-end"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/aof/artifact-sync-enqueue.mjs"
            ],
            "aofManaged": "claude-artifact-sync"
          }
        ]
      },
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/aof/run-heartbeat-enqueue.mjs"
            ],
            "aofManaged": "claude-run-heartbeat"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/aof/ask-pending-enqueue.mjs"
            ],
            "aofManaged": "claude-ask-pending"
          }
        ]
      }
    ]
  },
  "model": "sonnet",
  "effortLevel": "high"
}
